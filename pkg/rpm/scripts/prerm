#!/bin/bash
#
# GENERATED FROM pkg/scripts/prerm-common.sh via pkg/scripts/generate-postinst.sh
# — do not edit pkg/deb/scripts/prerm or pkg/rpm/scripts/prerm directly.
#
# Pre-removal for RPM: undo what postinst did outside the rpm file list — the copy
# of the extension inside PHP's extension_dir and the `extension=` line in php.ini.

set -e

[ "${1:-0}" = 0 ] || exit 0

# PHP minor release this package was built for, substituted at package build time.
# The extension only loads under exactly this minor version.
PHP_VERSION="@PHP_VERSION@"
case "$PHP_VERSION" in
    *@*) PHP_VERSION="" ;; # not substituted: a hand-built package, no pinned version
esac
PHP_BIN="php"

# Best effort from here on: a half-removed PHP must never block package removal,
# so every step degrades to a no-op instead of failing the transaction.
if ! command -v "$PHP_BIN" > /dev/null; then
    echo "$PHP_BIN not found — skipping Aerospike extension cleanup."
    exit 0
fi

EXT_DIR=$("$PHP_BIN" -r 'echo ini_get("extension_dir");' 2>/dev/null) || EXT_DIR=""
PHP_INI_PATH=$("$PHP_BIN" -r 'echo php_ini_loaded_file();' 2>/dev/null) || PHP_INI_PATH=""

# Mirror of the postinst copy: the .so inside PHP's extension_dir is not owned by
# the package manager, so nothing else would ever delete it.
if [[ -n "$EXT_DIR" && -f "$EXT_DIR/libaerospike_php.so" ]]; then
    echo "Removing Aerospike PHP extension from $EXT_DIR/"
    rm -f "$EXT_DIR/libaerospike_php.so" || true
fi

# Mirror of the postinst `extension=` line. Left behind it makes every later php
# invocation print "Unable to load dynamic library 'libaerospike_php.so'".
EXT_DIRECTIVE_RE='^[[:space:]]*extension[[:space:]]*=[[:space:]]*libaerospike_php\.so[[:space:]]*$'

if [[ -n "$PHP_INI_PATH" && -f "$PHP_INI_PATH" ]] \
    && grep -Eq "$EXT_DIRECTIVE_RE" "$PHP_INI_PATH"; then
    echo "Removing 'extension=libaerospike_php.so' from $PHP_INI_PATH"
    # Filtered through a temp file and written back into the original inode rather than
    # `sed -i`: that keeps php.ini's owner, mode and any hard links — it is a
    # package-manager conffile, not ours to replace. Writing in place truncates first,
    # so a failed write (ENOSPC, ...) would leave php.ini empty: take a backup before
    # touching it and restore from it on failure, and leave php.ini alone whenever any
    # step before the write fails.
    tmp_ini=$(mktemp) || tmp_ini=""
    if [[ -n "$tmp_ini" ]]; then
        # grep exits 1 when every line matched — a valid (empty) result; >1 is an error.
        grep_rc=0
        grep -Ev "$EXT_DIRECTIVE_RE" "$PHP_INI_PATH" > "$tmp_ini" || grep_rc=$?
        backup_ini="$PHP_INI_PATH.aerospike-prerm.bak"
        if (( grep_rc > 1 )); then
            echo "Could not filter $PHP_INI_PATH; leaving it unchanged." >&2
        elif ! cp -p "$PHP_INI_PATH" "$backup_ini"; then
            echo "Could not back up $PHP_INI_PATH; leaving it unchanged." >&2
        elif cat "$tmp_ini" > "$PHP_INI_PATH"; then
            rm -f "$backup_ini"
        else
            echo "Failed to rewrite $PHP_INI_PATH; restoring it from $backup_ini." >&2
            if cat "$backup_ini" > "$PHP_INI_PATH"; then
                rm -f "$backup_ini"
            else
                echo "Restore failed; the original is kept at $backup_ini." >&2
            fi
        fi
        rm -f "$tmp_ini"
    fi
fi

echo "Aerospike PHP client v2 removed."
