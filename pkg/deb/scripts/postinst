#!/bin/bash
#
# GENERATED FROM pkg/scripts/postinst-common.sh via pkg/scripts/generate-postinst.sh
# — do not edit pkg/deb/scripts/postinst or pkg/rpm/scripts/postinst directly.
#
# Post-install: drop the Aerospike PHP extension into the system PHP extension
# directory and enable it. No daemon to launch — the v2 extension talks to the
# Aerospike cluster directly.

set -e

log_error_and_exit() {
    echo "Error: $1" >&2
    exit 1
}

# PHP minor release this package was built for, substituted at package build time.
# The extension only loads under exactly this minor version.
PHP_VERSION="@PHP_VERSION@"
case "$PHP_VERSION" in
    *@*) PHP_VERSION="" ;; # not substituted: a hand-built package, no pinned version
esac
PHP_BIN="php${PHP_VERSION}"

# The package depends on this PHP's CLI, so it must be present. Never install a PHP
# from here: the distro default may be a different minor version, and the extension
# cannot load under it.
if ! command -v "$PHP_BIN" > /dev/null; then
    log_error_and_exit "$PHP_BIN not found; this package needs the PHP ${PHP_VERSION:-8.x} CLI."
fi

if [[ -n "$PHP_VERSION" ]]; then
    PHP_ACTUAL=$("$PHP_BIN" -r 'echo PHP_MAJOR_VERSION, ".", PHP_MINOR_VERSION;') \
        || log_error_and_exit "Failed to run $PHP_BIN."
    if [[ "$PHP_ACTUAL" != "$PHP_VERSION" ]]; then
        log_error_and_exit "$PHP_BIN is PHP $PHP_ACTUAL, but this package was built for PHP $PHP_VERSION and cannot load under another minor version."
    fi
fi

EXT_DIR=$("$PHP_BIN" -r 'echo ini_get("extension_dir");') \
    || log_error_and_exit "Failed to determine PHP extension directory."

PHP_INI_PATH=$("$PHP_BIN" -r 'echo php_ini_loaded_file();') \
    || log_error_and_exit "Failed to determine PHP INI file."

SO_FILE_PATH="/usr/lib/libaerospike_php.so"

if [[ ! -f "$SO_FILE_PATH" ]]; then
    log_error_and_exit "Aerospike PHP extension not found at $SO_FILE_PATH."
fi

if [[ -f "$EXT_DIR/libaerospike_php.so" ]]; then
    echo "Removing existing Aerospike PHP extension at $EXT_DIR/libaerospike_php.so"
    rm -f "$EXT_DIR/libaerospike_php.so" \
        || log_error_and_exit "Failed to remove existing extension."
fi

echo "Copying extension to $EXT_DIR/"
cp -f "$SO_FILE_PATH" "$EXT_DIR/" \
    || log_error_and_exit "Failed to copy extension."

# Tolerate the spacing php.ini allows around `=` so a second install does not
# append a duplicate directive (`extension = libaerospike_php.so` counts too).
EXT_DIRECTIVE_RE='^[[:space:]]*extension[[:space:]]*=[[:space:]]*libaerospike_php\.so[[:space:]]*$'

if [[ -n "$PHP_INI_PATH" ]] && ! grep -Eq "$EXT_DIRECTIVE_RE" "$PHP_INI_PATH"; then
    echo "Adding 'extension=libaerospike_php.so' to $PHP_INI_PATH"
    echo "extension=libaerospike_php.so" | tee -a "$PHP_INI_PATH" > /dev/null \
        || log_error_and_exit "Failed to add extension directive."
fi

echo "Aerospike PHP client v2 installed."
echo "Connect via Client::connect(\"host:port\", \$policy) — see README.md."
